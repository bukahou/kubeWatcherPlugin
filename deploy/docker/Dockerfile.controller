# =============================================================================
# AtlHyper Controller Dockerfile
# 后端控制器 (Master) - 提供 API 服务
# =============================================================================

ARG GO_VERSION=1.25

# -----------------------------------------------------------------------------
# Stage 1: Build
# -----------------------------------------------------------------------------
# --platform=$BUILDPLATFORM：构建阶段固定本机架构(x86)，不进 QEMU。
# 2026-08-29 驱动由 mattn/go-sqlite3(CGO) 换为 modernc.org/sqlite(纯 Go) 后，
# controller 也能像 agent 一样交叉编译 —— 此前因 CGO 需目标架构 C 工具链，
# arm64 那一半只能全程 QEMU 模拟，单次构建约 10 分钟。
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS builder

LABEL stage=builder

WORKDIR /app

# 依赖缓存优化
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO 已不再需要（纯 Go SQLite 驱动）；buildx 自动注入 TARGETARCH
ARG TARGETARCH
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=$TARGETARCH

# 编译优化: 去除调试信息减小体积
RUN go build -ldflags="-s -w" -o atlhyper-controller ./cmd/atlhyper_master_v2/main.go

# -----------------------------------------------------------------------------
# Stage 2: Runtime
# -----------------------------------------------------------------------------
FROM alpine:3.19

LABEL maintainer="AtlHyper Team"
LABEL description="AtlHyper Controller - Kubernetes Monitoring Platform API"

# 安装运行时依赖（kubectl: Deployer kustomize build 需要）
RUN apk add --no-cache sqlite-libs ca-certificates tzdata kubectl

# 设置时区
ENV TZ=Asia/Shanghai

WORKDIR /app

# 从构建阶段复制二进制
COPY --from=builder /app/atlhyper-controller .

# 创建数据目录
RUN mkdir -p /app/data && chmod +x ./atlhyper-controller

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

EXPOSE 8080

ENTRYPOINT ["./atlhyper-controller"]
