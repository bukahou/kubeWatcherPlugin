# =============================================================================
# AtlHyper Agent Dockerfile
# 集群数据采集代理 - 部署在各 K8s 集群中
# =============================================================================

ARG GO_VERSION=1.25

# -----------------------------------------------------------------------------
# Stage 1: Build
# -----------------------------------------------------------------------------
# --platform=$BUILDPLATFORM：构建阶段固定跑在【本机架构】（x86），不进 QEMU。
# Go 交叉编译能力极强，编译 arm64 产物无需模拟目标平台 ——
# 此前 arm64 一半整个走 QEMU 用户态模拟：单线程吃满一核（5.3GHz boost、
# Tctl 贴 95°C 温度墙），而 16 线程总占用只有 7%，编译慢 5-10 倍。
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS builder

LABEL stage=builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# buildx 自动注入 TARGETARCH（amd64 / arm64）；CGO 已禁用，交叉编译零障碍
ARG TARGETARCH
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=$TARGETARCH

RUN go build -ldflags="-s -w" -o atlhyper-agent ./cmd/atlhyper_agent_v2/main.go

# -----------------------------------------------------------------------------
# Stage 2: Runtime (使用 scratch 最小镜像)
# -----------------------------------------------------------------------------
FROM alpine:3.19

LABEL maintainer="AtlHyper Team"
LABEL description="AtlHyper Agent - Kubernetes Cluster Data Collector"

RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=builder /app/atlhyper-agent .

RUN chmod +x ./atlhyper-agent

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8082/health || exit 1

EXPOSE 8082

ENTRYPOINT ["./atlhyper-agent"]
