# =============================================================================
# AtlHyper Web Dockerfile
# Next.js 前端应用
# =============================================================================

ARG NODE_VERSION=20

# -----------------------------------------------------------------------------
# Stage 1: Dependencies
# -----------------------------------------------------------------------------
# --platform=$BUILDPLATFORM：deps 与 builder 固定跑在【本机架构】(x86)，不进 QEMU。
# next build 的产物（.next/ 下的 JS/静态文件）与 CPU 架构无关，只需构建一次。
# 此前两个架构各跑一遍完整 npm ci + next build，arm64 那遍全程 QEMU 模拟 ——
# 单线程吃满一核、Tctl 贴 95°C，是整个构建流程最慢的一段。
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS deps

LABEL stage=deps

WORKDIR /app

COPY atlhyper_web/package.json atlhyper_web/package-lock.json* ./

RUN npm ci --legacy-peer-deps

# -----------------------------------------------------------------------------
# Stage 2: Build
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS builder

LABEL stage=builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY atlhyper_web/ ./

ENV NEXT_TELEMETRY_DISABLED=1

# ⚠️ public/ 可能为空：图标改走 Next.js 的 app/ 文件约定后，public 下已无文件，
#    而 git 不追踪空目录 —— CI 干净检出时这个目录根本不存在，
#    下面 runner 阶段的 `COPY --from=builder /app/public` 就会失败。
#    本地构建看不出来（本地目录还在），只有 CI 会炸。
#    这里兜住：无论有没有静态资源，目录一定存在。
RUN mkdir -p public

RUN npm run build

# -----------------------------------------------------------------------------
# Stage 3: Runtime
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runner

LABEL maintainer="AtlHyper Team"
LABEL description="AtlHyper Web - Kubernetes Monitoring Dashboard"

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# 集群与运维均在 JST；此前误设 Asia/Shanghai(UTC+8) 导致全栈日志与
# SQLite 时间戳比真实时间慢 1 小时，2026-08-29 压测排查时实际造成误判。
ENV TZ=Asia/Tokyo

# 安装时区支持
RUN apk add --no-cache tzdata

# 创建非 root 用户
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# 复制构建产物（确保权限正确）
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# 设置权限
RUN mkdir .next && chown nextjs:nodejs .next

# 复制 standalone 输出
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# ⚠️ sharp 是 native addon，standalone 里带的是【构建机架构】(x64) 的二进制。
#    本项目未使用 next/image（已核验：src 下零处引用），sharp 属 Next 默认
#    打包进来的死代码，运行时不会被 require —— 但留着错架构的 .node 文件
#    既是隐患也占体积，直接删掉，由 Next 在真需要时报明确错误而非静默行为异常。
#    若将来引入 next/image：把此处改为 `npm i --os=linux --cpu=$TARGETARCH sharp`。
RUN rm -rf ./node_modules/@img

USER nextjs

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
